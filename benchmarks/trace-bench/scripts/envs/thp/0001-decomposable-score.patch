     def _hill_climb(self):
+        """
+        Search the best causal graph, then generate the causal matrix (DAG).
+
+        [0001-decomposable-score] The shipped search (kept below as
+        `_hill_climb_shipped`) refits the EM over every event type for every
+        ordered pair of types in every sweep. Its score is decomposable: `_em`
+        fits each type from its own column of the adjacency alone and sums the
+        per-type likelihoods in index order, and the penalty depends only on
+        the edge count. This search computes the same numbers -- `_em_type` is
+        the loop body of `_em` run on arrays of the same layout, a candidate's
+        score is the same ordered sum of the same per-type values minus the
+        same penalty expression -- and accepts the same move per sweep (the
+        first candidate in `product` order at the strict maximum), so its
+        output is the shipped output. It differs in cost only: per-type values
+        are cached by (type, parent set); a move changes at most two columns,
+        so at most two fits are new per candidate and, across sweeps, only the
+        candidates touching the last move's columns need a fit; pairs the
+        prior fixes (forbidden, required, the diagonal) and cyclic candidates
+        are not fitted (the shipped code fits them and never accepts them).
+        The shipped function stays the reference: the final graph is refitted
+        by `_em` and its score must equal the search's, or the search raises.
+
+        Returns
+        -------
+        result: tuple, (likelihood, alpha matrix, events vector)
+        edge_mat: np.ndarray
+            Causal matrix.
+        """
+        self._get_effect_tensor_decays()
+        N = self._N
+        K = self._max_hop
+        pk = self.priori_knowledge
+        edge_mat = np.eye(N, N)
+        edge_mat[pk.matrix == 1] = 1  # only add the required edges to edge_mat
+        if not nx.is_directed_acyclic_graph(nx.DiGraph((edge_mat - np.eye(N, N)))):
+            return self._hill_climb_shipped()  # a cyclic start: the shipped search's case
+        self._alpha_scratch = np.ones([K + 1, N, N])
+        self._mu_scratch = np.ones(N)
+        cache = {}
+        log_s = np.log(self.tensor['times'].sum())
+
+        def li_of(i, parents):
+            key = (i, tuple(sorted(int(p) for p in parents)))
+            li = cache.get(key)
+            if li is None:
+                col = np.zeros(N)
+                col[list(key[1])] = 1
+                li = cache[key] = self._em_type(i, col)
+            return li
+
+        def penalty(e):
+            if self._penalty == 'AIC':
+                return N + self._epsilon * e * (K + 1)
+            elif self._penalty == 'BIC':
+                return (N + self._epsilon * e * (K + 1)) * log_s / 2
+            else:
+                raise ValueError("The penalty's value should be BIC or AIC.")
+
+        # the candidates, in the shipped `product` order, less the pairs no move touches
+        cand = [(j, i) for j in range(N) for i in range(N)
+                if j != i and not pk.is_required(j, i) and not pk.is_forbidden(j, i)]
+        cj = np.array([j for j, _ in cand], dtype=np.int64)
+        ci = np.array([i for _, i in cand], dtype=np.int64)
+        pa = [set(np.where(edge_mat[:, i] == 1)[0].tolist()) for i in range(N)]
+        base = np.array([li_of(i, pa[i]) for i in range(N)])
+        E = edge_mat.sum()
+        l_ret = np.add.accumulate(base)[-1] - penalty(E)
+        self.moves_ = []
+        stop_tag = True
+        num_iter = -1
+        for num_iter in range(self._max_iter):
+
+            logging.info('[iter {}]: likelihood_score = {}'.format(num_iter, l_ret))
+
+            stop_tag = True
+            G = edge_mat.astype(bool)
+            np.fill_diagonal(G, False)
+            R = self._reachability(G)
+            GR = G.astype(np.int64) @ R.astype(np.int64)
+            present = G[cj, ci]
+            reverse = ~present & G[ci, cj]
+            valid = np.ones(len(cand), dtype=bool)
+            valid[~present & ~reverse & R[ci, cj]] = False  # an added edge that closes a cycle
+            valid[reverse & (GR[ci, cj] != 1)] = False  # a reversal with another path i -> j
+            d_e = np.where(present, -1.0, np.where(reverse, 0.0, 1.0))
+            L = np.tile(base, (len(cand), 1))
+            touched = []
+            for c, (j, i) in enumerate(cand):
+                if not valid[c]:
+                    touched.append(None)
+                    continue
+                if present[c]:
+                    new_i = pa[i] - {j}
+                    new_j = None
+                elif pk.is_required(i, j):
+                    valid[c] = False
+                    touched.append(None)
+                    continue
+                else:
+                    new_i = pa[i] | {j}
+                    new_j = (pa[j] - {i}) if reverse[c] else None
