+            if best > l_ret:
+                c = int(np.flatnonzero(scores == best)[0])
+                j, i = cand[c]
+                new_i, new_j = touched[c]
+                if present[c]:
+                    edge_mat[j, i] = 0
+                else:
+                    edge_mat[j, i] = 1
+                    edge_mat[i, j] = 0
+                pa[i] = new_i
+                base[i] = L[c, i]
+                if new_j is not None:
+                    pa[j] = new_j
+                    base[j] = L[c, j]
+                E = E + d_e[c]
+                l_ret = best
+                stop_tag = False
+                self.moves_.append((num_iter, int(j), int(i),
+                                    'delete' if present[c] else ('reverse' if reverse[c] else 'add')))
+
+            if stop_tag:
