+        if result[0] != l_ret:
+            raise RuntimeError('decomposable score {} != _em score {}'.format(l_ret, result[0]))
+        return result, edge_mat
+
+    @staticmethod
+    def _reachability(G):
+        """[0001-decomposable-score] Reflexive reachability of a DAG by squaring."""
+        R = G | np.eye(len(G), dtype=bool)
+        while True:
+            R2 = R | ((R.astype(np.int64) @ R.astype(np.int64)) > 0)
+            if np.array_equal(R2, R):
+                return R
+            R = R2
+
+    def _em_type(self, i, col):
+        """[0001-decomposable-score] The per-type fit of `_em`: its loop body for
+        the one event type `i` whose adjacency column is `col`, on scratch arrays
+        of the shipped layout (alpha (K+1, N, N), mu (N,)); returns `li`."""
+        alpha = self._alpha_scratch
+        mu = self._mu_scratch
+        alpha[:, :, i] = col
+        mu[i] = 1
+        pa_i = set(np.where(col == 1)[0])
+        li = -100000000000
+        ind = np.where(self._event_indexes == i)
+        x_i = self.tensor['times'].values[ind]
+        while 1:
+            # Calculate the first part of the likelihood
+            lambda_i_sum = (self._decay_effects
+                            * alpha[:, :, i].T).sum() + mu[i] * self._T
+
+            # Calculate the second part of the likelihood
+            lambda_for_i = np.zeros(len(self.tensor)) + mu[i]
+            for k in range(self._max_hop+1):
+                lambda_for_i += np.matmul(
+                    self._effect_tensor_decays[k, :],
+                    alpha[k, :, i].T)
+            lambda_for_i = lambda_for_i[ind]
+            x_log_lambda = (x_i * np.log(lambda_for_i)).sum()
+            new_li = -lambda_i_sum + x_log_lambda
+
+            # Iteration termination condition
+            delta = new_li - li
+            if delta < 0.1:
+                return new_li
+            li = new_li
+            # update mu
+            mu[i] = ((mu[i] / lambda_for_i) * x_i).sum() / self._T
+            # update alpha
+            for j in pa_i:
+                for k in range(self._max_hop+1):
+                    upper = ((alpha[k, j, i] * (
+                        self._effect_tensor_decays[k, :, j])[ind]
+                              / lambda_for_i) * x_i).sum()
+                    lower = self._decay_effects[j, k]
+                    if lower == 0:
+                        alpha[k, j, i] = 0
+                        continue
+                    alpha[k, j, i] = upper / lower
+
