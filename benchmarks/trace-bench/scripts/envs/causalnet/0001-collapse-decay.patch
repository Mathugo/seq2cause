+    def final_prob(self):
+        """
+        The shipped read-out (steps a-d of the training loop, saved as dags/final_prob): for every
+        type pair (i, j), p_ij = sigmoid(graph[i, j]) times the maximum over every (k, u, v) slot
+        with A[k][u, v] != 0 of sigmoid(theta[k, u, v, i, j] * A[k][u, v]). In the full tensor the
+        only slot that is ever trained for (i, j) is (node_of_type[i], node_of_type[j]) (when each
+        type lives on one node); every other slot keeps its initial value 0 and contributes
+        sigmoid(0) = 0.5. The collapsed mode reproduces that maximum exactly [lab patch
+        0001-collapse-decay]: max(gated, 0.5 * other), gated = max_k A_types[k][i, j] *
+        sigmoid(theta[k, i, j]), other = 1 iff some k has a nonzero A[k] slot outside (node_of_type[i],
+        node_of_type[j]). The read-out `gated` (config `readout: gated`) returns p_ij * gated
+        instead (the paper's Eq. 16 over the trained slots only); `shipped` is the default.
+        """
+        with torch.no_grad():
+            prob_mat = torch.sigmoid(self.graph.detach())
+            if self.theta_mode == 'collapsed':
+                sig = torch.stack([torch.sigmoid(self.theta.detach()[k]) * self.A_types[k].ne(0).float() for k in range(len(self.A))])
+                gated, _ = torch.max(sig, dim=0)  # (n_type, n_type)
+                readout = str(self.args.get('readout', 'shipped'))
+                if readout == 'gated':
+                    return prob_mat * gated
+                other = torch.zeros_like(gated)
+                for k in range(len(self.A)):
+                    nnz = self.A[k].ne(0).float().sum()
+                    other = torch.maximum(other, (nnz - self.A_types[k].ne(0).float()).gt(0).float())
+                return prob_mat * torch.maximum(gated, 0.5 * other)
+            ##   b.
+            adjacency = torch.stack(self.A)  # (max_hop,n_topo,n_topo)
+            decay = self.theta.detach().permute(3,4,0,1,2)  # (max_hop,n_topo,n_topo,n_type,n_type) -> (n_type,n_type,max_hop,n_topo,n_topo)
+            decay_adj = decay * adjacency
+            prob_decay = torch.sigmoid(decay_adj)
+            prob_decay = prob_decay.permute(2,3,4,0,1)  # (n_type,n_type,max_hop,n_topo,n_topo) -> (max_hop,n_topo,n_topo,n_type,n_type)
+            prob_mat_decayed = prob_mat * prob_decay
+            prob_mat_decayed = prob_mat_decayed.permute(3,4,0,1,2)  # (max_hop,n_topo,n_topo,n_type,n_type) -> (n_type,n_type,max_hop,n_topo,n_topo)
+            ##   c.
+            prob_mat_decayed_adj = prob_mat_decayed * adjacency.ne(0).float()
+            ##   d.
+            prob_mat_decayed_adj_max = prob_mat_decayed_adj + torch.zeros_like(prob_mat_decayed_adj)
+            for _ in range(3):
+                prob_mat_decayed_adj_max, _ = torch.max(prob_mat_decayed_adj_max, dim=-1)
+            return prob_mat_decayed_adj_max
