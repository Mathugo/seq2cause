+def get_causal_decay_coef_collapsed(event_num, event_type, theta, A_types):
+    """
+    The decay coefficient with the causal decay matrix collapsed to (max_hop+1, n_type, n_type)
+    [lab patch 0001-collapse-decay]. When every event type lives on exactly one topological node
+    (node = node_of_type[type]), the full tensor theta[k, u, v, i, j] is only ever read, and only
+    ever receives gradient, at (u, v) = (node_of_type[i], node_of_type[j]); this function reads
+    theta[k, i, j] with the type-level hop adjacency A_types[k][i, j] = A[k][node_of_type[i],
+    node_of_type[j]] and returns the same (sz_b, len_q, len_k) coefficient as
+    get_causal_decay_coef does with the full tensor (see the equality check in RUN.md, D-CN-1).
+    """
+    n_node = theta.shape[1]
+    sz_b, len_s = event_type.size()
+    len_q, len_k = len_s, len_s
+    device = event_type.device
+
+    # the event type of each predicted event
+    event_type = event_type - 1  # -1 because 0 means PAD
+    target_types = _target_index(event_num, event_type).to(torch.int64)
+
+    # parents_t[b, i] = sum_k A_types[k][i, type_b] * sigmoid(theta[k, i, type_b])
+    parents_t = torch.zeros(sz_b, n_node, device=device)
+    max_hop = len(theta) - 1
+    for k in range(0, max_hop+1):
+        sig_theta_k = torch.sigmoid(theta[k]) * A_types[k].ne(0).float()  # (n_node, n_node)
+        parents_t += sig_theta_k[:, target_types].transpose(0, 1)  # (sz_b, n_node)
+
+    causal_decay_coef = parents_t[torch.arange(sz_b, device=device)[:, None].expand(-1, len_k), event_type.to(torch.int64)]  # (sz_b, len_k)
+    causal_decay_coef = causal_decay_coef.unsqueeze(1).expand(-1, len_q, -1)  # (sz_b, len_q, len_k)
+    return causal_decay_coef
+
