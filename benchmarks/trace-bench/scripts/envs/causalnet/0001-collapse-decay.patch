+def node_of_type_from_data(data, num_types):
+    """
+    The topological node of every event type when each type lives on exactly one node (the
+    condition under which the causal decay matrix collapses without loss; lab patch
+    0001-collapse-decay). Raises if a type occurs on two nodes.
+    """
+    node_of_type = np.full(num_types, -1, dtype=np.int64)
+    for seq in data:
+        for event in seq:
+            v, n = int(event['type_event']), int(event['topo'])
+            if node_of_type[v] == -1:
+                node_of_type[v] = n
+            elif node_of_type[v] != n:
+                raise ValueError(f'event type {v} occurs on nodes {node_of_type[v]} and {n}: the collapsed decay matrix needs one node per type')
+    if (node_of_type < 0).any():
+        raise ValueError('every event type must occur at least once to collapse the decay matrix')
+    return node_of_type
+
